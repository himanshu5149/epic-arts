# Demo checkout is enabled only in development by default.
PORT=3000
# Public HTTPS origin used for canonical links and payment redirects.
SITE_URL=https://your-gallery.example
# Explicitly set true to offer free sample orders in production.
DEMO_CHECKOUT=false
# Live Stripe checkout (never expose secret keys in the browser).
# Cards + any wallets enabled on your Stripe dashboard (Apple Pay, Google Pay, Link).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
# Razorpay — UPI, cards, netbanking & wallets (amounts charged in INR).
# RAZORPAY_WEBHOOK_SECRET additionally enables signed payment.captured/payment.failed webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Fixed shop conversion rate for INR billing (Razorpay charges whole paise).
USD_INR_RATE=84
# PayPal Orders API v2 (server-to-server; the browser only ever holds the approval redirect).
# PAYPAL_ENV=sandbox until you are ready to collect real money, then 'live'.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Persistent storage: mount this directory on your production host.
DATA_DIR=./store
# Optional Resend transactional email for receipts and download links.
RESEND_API_KEY=
MAIL_FROM=Epic Arts <orders@your-gallery.example>

# Reproducible preview/export cache. Regenerable; never expose as a static directory.
# In Docker this defaults to /data/cache. The source-image folder in DATA_DIR is NOT regenerable.
# CACHE_DIR=./.cache
MAX_CACHE_MB=256
# Optional live Image AI. The built-in engine never needs this key.
# Both the flag and a valid key are required; defaults are intentionally off.
AI_GENERATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Maximum image-AI job reservations across this installation per UTC day (1–20).
# Also configure a hard provider-side spend cap; a job quota is not a financial guarantee.
AI_DAILY_LIMIT=5

# Optional Art Advisor language model. Independent of the image-AI flag.
# Default no-key retrieval/rules require neither of these settings.
# The visitor must also explicitly opt in for each connected-model brief.
AGENT_LLM_ENABLED=false
OPENAI_AGENT_MODEL=gpt-4.1-mini
# Installation-wide model job reservations per UTC day (1–50); failures count.
# Up to 3 model calls / 4 read-only tool calls per attempt, at most 2 interrupted attempts.
# Also 6 model reservations and 60 total advisor briefs per session/day.
AGENT_DAILY_LLM_LIMIT=20
# SQLite is a SINGLE-INSTANCE deployment: 1–3 workers in this process, queue cap 12.
AGENT_WORKERS=2
# Configure an external provider spending limit; reservation quotas are not a financial guarantee.
